{
  "name": "dsh-think-zh",
  "version": "0.1.0",
  "description": "DSHA plugin: keep the agent's thinking process (reasoning blocks) in Simplified Chinese",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "cordis": {
    "entry": "lib/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "thinking",
    "chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArknightsPlayer/dsh-think-zh.git"
  },
  "homepage": "https://github.com/ArknightsPlayer/dsh-think-zh#readme",
  "bugs": {
    "url": "https://github.com/ArknightsPlayer/dsh-think-zh/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
